@charset "utf-8";

.cam-wrap { font-family: var(--kimi-font-sans, sans-serif); display: flex; =
flex-direction: column; align-items: center; gap: 12px; max-width: 380px; m=
argin: 0px auto; }

.cam-wrap button { font: inherit; color: inherit; background: none; border-=
width: medium; border-style: none; border-color: currentcolor; border-image=
: none; cursor: pointer; }

.cam-wrap svg { display: block; }

.seg { display: flex; gap: 4px; border: 1px solid var(--kimi-color-border);=
 border-radius: 8px; padding: 4px; }

.seg-btn { padding: 6px 12px; border-radius: 6px; font-size: 14px; color: v=
ar(--kimi-color-text-secondary); transition: all var(--t-fast) var(--ease-o=
ut); }

.seg-btn.on { background: var(--kimi-color-text-primary); color: var(--kimi=
-color-surface); }

.phone { width: 300px; border: 1px solid var(--kimi-color-border); border-r=
adius: 24px; padding: 12px; transition: all var(--t-normal) var(--ease-stan=
dard); }

.screen { position: relative; border-radius: 12px; background: var(--kimi-c=
olor-surface-strong); overflow: hidden; height: 460px; display: flex; flex-=
direction: column; }

.vf { flex: 1 1 0%; display: flex; align-items: center; justify-content: ce=
nter; }

.vf-label { font-size: 12px; color: var(--kimi-color-text-quaternary); }

.topbar { position: absolute; top: 12px; left: 12px; right: 12px; display: =
flex; align-items: center; gap: 8px; }

.tb-spacer { flex: 1 1 0%; }

.tb-group { display: flex; gap: 8px; }

.pill { width: 36px; height: 36px; border-radius: 999px; display: flex; ali=
gn-items: center; justify-content: center; background: color-mix(in srgb, v=
ar(--kimi-color-text-primary) 8%, transparent); color: var(--kimi-color-tex=
t-primary); border: 1px solid color-mix(in srgb, var(--kimi-color-border) 5=
5%, transparent); transition: transform var(--t-fast) var(--ease-out), back=
ground var(--t-fast) var(--ease-out); }

.pill:active { transform: scale(0.92); }

.dock { position: absolute; left: 0px; right: 0px; bottom: 0px; display: fl=
ex; flex-direction: column; align-items: center; gap: 16px; padding: 16px 1=
6px 24px; }

.modepill { position: relative; display: flex; border-radius: 999px; backgr=
ound: color-mix(in srgb, var(--kimi-color-text-primary) 8%, transparent); b=
order: 1px solid color-mix(in srgb, var(--kimi-color-border) 55%, transpare=
nt); padding: 3px; }

.mode { position: relative; z-index: 1; padding: 5px 16px; font-size: 13px;=
 border-radius: 999px; color: var(--kimi-color-text-secondary); transition:=
 color var(--t-fast) var(--ease-out); }

.mode.on { color: var(--kimi-color-surface); }

.slider { position: absolute; top: 3px; left: 3px; width: calc(50% - 3px); =
bottom: 3px; border-radius: 999px; background: var(--kimi-color-text-primar=
y); transition: transform var(--t-normal) var(--ease-standard); }

.mode-video .slider { transform: translateX(100%); }

.controls { display: flex; align-items: center; gap: 24px; }

.shutter { width: 72px; height: 72px; border-radius: 999px; border: 4px sol=
id var(--kimi-color-text-primary); display: flex; align-items: center; just=
ify-content: center; transition: transform var(--t-fast) var(--ease-out), b=
order-color var(--t-normal) var(--ease-standard); }

.shutter:active { transform: scale(0.9); }

.disc { width: 56px; height: 56px; border-radius: 999px; background: var(--=
kimi-color-text-primary); transition: all var(--t-fast) var(--ease-out); }

.rec { display: none; width: 30px; height: 30px; border-radius: 6px; backgr=
ound: var(--kimi-color-text-primary); transition: all var(--t-fast) var(--e=
ase-out); }

.mode-video .disc { display: none; }

.mode-video .rec { display: block; }

.mode-video .rec { background: var(--kimi-color-danger); }

.ghost { visibility: hidden; }

.phone.v-gold .shutter { border-color: var(--kimi-color-warning); }

.phone.v-gold .flash { color: var(--kimi-color-warning); background: color-=
mix(in srgb, var(--kimi-color-warning) 16%, transparent); border-color: tra=
nsparent; }

.phone.v-gold .mode.on { color: var(--kimi-color-warning); }

.phone.v-gold .slider { background: color-mix(in srgb, var(--kimi-color-war=
ning) 22%, transparent); }

.phone.v-bar .dock { background: var(--kimi-color-surface-raised); border-t=
op: 1px solid var(--kimi-color-border); border-radius: 12px 12px 0px 0px; p=
adding-top: 12px; }

.phone.v-bar .tb-group { display: none; }

.phone.v-bar .dock::before { content: ""; position: absolute; top: -46px; l=
eft: 50%; transform: translateX(-50%); width: 4px; height: 4px; border-radi=
us: 999px; background: var(--kimi-color-text-quaternary); box-shadow: -14px=
 0 0 var(--kimi-color-text-quaternary),14px 0 0 var(--kimi-color-text-quate=
rnary); }

.cap { margin: 0px; font-size: 13px; color: var(--kimi-color-text-tertiary)=
; text-align: center; min-height: 20px; }

.pick { padding: 8px 20px; border-radius: 999px; background: var(--kimi-col=
or-text-primary); color: var(--kimi-color-surface); font-size: 14px; transi=
tion: transform var(--t-fast) var(--ease-out); }

.pick:active { transform: scale(0.96); }
