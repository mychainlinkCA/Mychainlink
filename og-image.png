@charset "utf-8";

.vine-wrap { font-family: var(--kimi-font-sans,sans-serif); display: flex; =
flex-direction: column; align-items: center; gap: 12px; max-width: 380px; m=
argin: 0px auto; }

.vine-wrap button { font: inherit; color: inherit; background: none; border=
-width: medium; border-style: none; border-color: currentcolor; border-imag=
e: none; cursor: pointer; }

.vine-wrap svg { display: block; }

.seg { display: flex; gap: 4px; border: 1px solid var(--kimi-color-border);=
 border-radius: 8px; padding: 4px; }

.seg-btn { padding: 6px 12px; border-radius: 6px; font-size: 14px; color: v=
ar(--kimi-color-text-secondary); transition: all var(--t-fast) var(--ease-o=
ut); }

.seg-btn.on { background: var(--kimi-color-text-primary); color: var(--kimi=
-color-surface); }

.phone { width: 300px; border: 1px solid var(--kimi-color-border); border-r=
adius: 24px; padding: 12px; transition: border-color var(--t-normal) var(--=
ease-standard); }

.screen { position: relative; border-radius: 12px; background: var(--kimi-c=
olor-surface-strong); height: 480px; display: flex; flex-direction: column;=
 align-items: center; overflow: hidden; }

.topbar { width: 100%; display: flex; align-items: center; gap: 8px; paddin=
g: 12px 16px; }

.tb-spacer { flex: 1 1 0%; }

.wordmark { font-size: 20px; font-weight: 500; letter-spacing: 0px; }

.pill { width: 36px; height: 36px; border-radius: 999px; display: flex; ali=
gn-items: center; justify-content: center; background: color-mix(in srgb,va=
r(--kimi-color-text-primary) 8%,transparent); color: var(--kimi-color-text-=
primary); border: 1px solid color-mix(in srgb,var(--kimi-color-border) 55%,=
transparent); transition: all var(--t-fast) var(--ease-out); }

.pill:active { transform: scale(0.92); }

.pill.on { color: var(--acc); background: color-mix(in srgb,var(--acc) 16%,=
transparent); border-color: transparent; }

.vf-square { position: relative; width: 276px; height: 276px; border-radius=
: 16px; margin-top: 4px; display: flex; align-items: center; justify-conten=
t: center; background: color-mix(in srgb,var(--kimi-color-text-primary) 5%,=
transparent); border: 1px dashed color-mix(in srgb,var(--kimi-color-border)=
 70%,transparent); }

.vf-tag { position: absolute; top: 8px; left: 12px; font-size: 12px; color:=
 var(--kimi-color-text-quaternary); }

.live-frame { color: var(--kimi-color-text-primary); opacity: 0.85; }

.ghost-frame { position: absolute; display: none; color: var(--kimi-color-t=
ext-quaternary); transform: translate(10px, -10px); }

.ghost-on .ghost-frame { display: block; }

.loop-badge { position: absolute; top: 76px; right: 20px; display: none; al=
ign-items: center; gap: 6px; font-size: 12px; color: var(--kimi-color-text-=
secondary); background: var(--kimi-color-surface-raised); border: 1px solid=
 var(--kimi-color-border); border-radius: 999px; padding: 5px 10px; }

.loop-on .loop-badge { display: flex; }

.dock { width: 100%; display: flex; align-items: center; justify-content: s=
pace-between; padding: 16px 24px 8px; }

.rec { position: relative; width: 92px; height: 92px; display: flex; align-=
items: center; justify-content: center; transition: transform var(--t-fast)=
 var(--ease-out); }

.rec:active { transform: scale(0.93); }

.ring { position: absolute; inset: 0px; width: 92px; height: 92px; }

.track { fill: none; stroke: color-mix(in srgb,var(--kimi-color-text-primar=
y) 18%,transparent); stroke-width: 5; }

.fill { fill: none; stroke: var(--acc); stroke-width: 5; stroke-linecap: ro=
und; stroke-dasharray: 0, 999; transition: stroke-dasharray .9s var(--ease-=
standard); }

.rec-disc { width: 62px; height: 62px; border-radius: 999px; background: va=
r(--kimi-color-text-primary); transition: all var(--t-fast) var(--ease-out)=
; }

.recording .rec-disc { background: var(--kimi-color-danger); border-radius:=
 14px; width: 40px; height: 40px; }

.thumb { width: 44px; height: 44px; border-radius: 10px; display: flex; ali=
gn-items: center; justify-content: center; background: color-mix(in srgb,va=
r(--kimi-color-text-primary) 8%,transparent); color: var(--kimi-color-text-=
secondary); border: 1px solid color-mix(in srgb,var(--kimi-color-border) 55=
%,transparent); }

.next { width: 44px; height: 44px; border-radius: 999px; display: flex; ali=
gn-items: center; justify-content: center; background: var(--kimi-color-tex=
t-primary); color: var(--kimi-color-surface); opacity: 0.35; transition: al=
l var(--t-fast) var(--ease-out); }

.next.ready { opacity: 1; }

.next.ready:active { transform: scale(0.94); }

.hint { margin: 0px; padding: 0px 24px 16px; font-size: 13px; color: var(--=
kimi-color-text-tertiary); text-align: center; }

.a-gold { --acc: var(--kimi-color-warning); }

.a-vine { --acc: var(--kimi-color-positive); }

.cap { margin: 0px; font-size: 13px; color: var(--kimi-color-text-tertiary)=
; text-align: center; }

.pick { padding: 8px 20px; border-radius: 999px; background: var(--kimi-col=
or-text-primary); color: var(--kimi-color-surface); font-size: 14px; transi=
tion: transform var(--t-fast) var(--ease-out); }

.pick:active { transform: scale(0.96); }
