: var(--ui-B2-font-size); line-height: var(--ui-B2-line-height); letter-spa=
cing: 0.25px; color: var(--button-color); border-color: var(--button-border=
-color); box-sizing: border-box; border-radius: 10px; margin-right: 8px; pa=
dding: 10px 15px; background-color: var(--button-bg) !important; }

