@charset "utf-8";

.landing-page { position: fixed; inset: 0px; z-index: 1000; overflow-y: aut=
o; display: flex; flex-direction: column; justify-content: center; backgrou=
nd: var(--bg); transition: opacity .5s var(--ease); }

.landing-page.hidden { opacity: 0; pointer-events: none; display: none !imp=
ortant; }

.landing-glow { position: absolute; inset: 0px; pointer-events: none; backg=
round: radial-gradient(78% 46% at 14% 6%, rgba(230, 201, 106, 0.18), transp=
arent 62%), radial-gradient(64% 42% at 104% 92%, rgba(201, 162, 67, 0.11), =
transparent 64%); }

.landing-content { position: relative; width: 100%; max-width: 440px; paddi=
ng: 56px 26px 26px; margin: auto; }

.landing-content > * { animation: rise .85s var(--ease-out) both; }

.landing-logo { animation-delay: 0.05s; }

.landing-lead { animation-delay: 0.12s; }

.landing-quote { animation-delay: 0.22s; }

.landing-tagline { animation-delay: 0.32s; }

.landing-actions { animation-delay: 0.42s; }

.landing-logo { margin-bottom: 34px; text-align: center; }

.landing-logo img { width: 186px; height: auto; display: block; margin: 0px=
 auto; filter: drop-shadow(rgba(230, 201, 106, 0.28) 0px 18px 44px); mix-bl=
end-mode: normal; background-color: transparent !important; }

.landing-logo, .auth-logo { background: none !important; box-shadow: none !=
important; border-width: medium !important; border-style: none !important; =
border-color: currentcolor !important; border-image: none !important; borde=
r-radius: 0px !important; }

.lead-eyebrow { display: flex; align-items: center; gap: 9px; font-size: 10=
.5px; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; =
color: var(--gold); margin-bottom: 16px; }

.lead-eyebrow span { width: 7px; height: 7px; border-radius: 50%; backgroun=
d: var(--gold); flex-shrink: 0; box-shadow: rgba(230, 201, 106, 0.15) 0px 0=
px 0px 4px; animation: 2.6s ease-in-out 0s infinite normal none running pul=
se; }

.lead-h { font-family: var(--font-d); font-size: clamp(38px, 11.5vw, 50px);=
 font-weight: 750; line-height: 1.02; letter-spacing: -0.035em; color: var(=
--ink); margin-bottom: 18px; }

.lead-h em { font-style: italic; font-weight: 600; color: var(--gold); back=
ground-image: ; background-position-x: ; background-position-y: ; backgroun=
d-size: ; background-repeat: ; background-attachment: ; background-origin: =
; background-color: ; background-clip: text; -webkit-text-fill-color: trans=
parent; }

.lead-sub { font-size: clamp(18px, 4vw, 22px); line-height: 1.55; color: va=
r(--ink-2); max-width: 37ch; margin-bottom: 38px; font-weight: 700; }

.landing-tagline { font-size: clamp(20px, 4.8vw, 26px); line-height: 1.5; c=
olor: var(--ink-2); font-weight: 700; text-align: center; margin: 10px 0px =
28px; letter-spacing: -0.01em; }

.landing-actions { display: flex; flex-direction: column; gap: 11px; margin=
-bottom: 28px; }

.landing-actions .btn { width: 100%; }

.landing-quote { position: relative; max-width: 42ch; padding: 18px 22px 16=
px 48px; overflow: hidden; border: 1px solid var(--gold-edge); border-radiu=
s: var(--r-lg); background: linear-gradient(135deg, rgba(230, 201, 106, 0.1=
1), rgba(23, 22, 20, 0.72) 58%); box-shadow: rgba(242, 223, 160, 0.08) 0px =
1px 0px inset, rgba(230, 201, 106, 0.65) 0px 18px 45px -30px; margin-bottom=
: 0px; transition: opacity .4s var(--ease); }

.landing-quote.fade-out { opacity: 0.2; }

.landing-quote.fade-in { opacity: 1; }

.landing-quote::before { content: "=E2=80=9C"; position: absolute; left: 14=
px; top: 4px; font-family: var(--font-d); font-size: 48px; font-weight: 700=
; line-height: 1; color: var(--gold); }

.landing-quote blockquote { font-family: var(--font-b); font-style: normal;=
 font-size: 16.5px; line-height: 1.45; font-weight: 500; color: var(--ink);=
 margin-bottom: 8px; }

.landing-quote figcaption { font-size: 10.5px; color: var(--gold-deep); fon=
t-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; }

.landing-quote figcaption::before { content: "- "; color: var(--gold); }

.landing-foot { position: relative; padding: 26px; text-align: left; max-wi=
dth: 440px; width: 100%; font-size: 9px; color: var(--ink-4); letter-spacin=
g: 0.02em; opacity: 0.45; }

.landing-foot a { font-size: 12px; color: var(--gold); text-decoration: non=
e; margin: 0px 6px; opacity: 1; }

@media (min-width: 760px) {
  .landing-page { justify-content: center; align-items: center; }
  .landing-content { max-width: 620px; padding: 0px 64px; margin: auto; tex=
t-align: center; }
  .landing-logo { text-align: center; }
  .landing-foot { padding: 0px 64px; margin: 44px auto 0px; max-width: 620p=
x; text-align: center; }
  .lead-h { font-size: 62px; }
  .landing-tagline { font-size: 24px; max-width: 50ch; margin-left: auto; m=
argin-right: auto; }
  .landing-actions { flex-direction: row; max-width: 460px; margin-left: au=
to; margin-right: auto; }
  .landing-actions .btn { width: auto; flex: 1 1 0%; }
  .landing-quote { margin-left: auto; margin-right: auto; }
}

@media (max-height: 680px) {
  .landing-content { padding-top: 34px; }
  .landing-logo { margin-bottom: 22px; }
  .landing-tagline { margin: 6px 0px 18px; }
  .landing-actions { margin-bottom: 18px; }
  .landing-quote { display: none; }
  .story-ring { width: 56px; height: 56px; }
  .story-ring-inner { font-size: 18px; }
  .story-name { font-size: 10px; max-width: 60px; }
}

.stories-bar { display: flex; gap: 12px; overflow-x: auto; padding: 12px 4p=
x 16px; margin: -8px -8px 8px; scrollbar-width: none; }

.stories-bar::-webkit-scrollbar { display: none; }

.story-item { flex-shrink: 0; display: flex; flex-direction: column; align-=
items: center; gap: 6px; width: 72px; }

.story-ring { width: 64px; height: 64px; border-radius: 50%; padding: 3px; =
background: linear-gradient(135deg,var(--gold),var(--gold-hi),var(--gold-de=
ep)); position: relative; }

.story-ring.seen { background: var(--surf-3); }

.story-ring.live { background: linear-gradient(135deg, rgb(255, 51, 102), r=
gb(255, 107, 107), rgb(255, 51, 102)); animation: 2s ease 0s infinite norma=
l none running pulseLive; }

.story-ring-inner { width: 100%; height: 100%; border-radius: 50%; backgrou=
nd: var(--surf); display: flex; align-items: center; justify-content: cente=
r; overflow: hidden; font-weight: 800; font-size: 22px; color: rgb(20, 18, =
14); }

.story-ring-inner img { width: 100%; height: 100%; object-fit: cover; }

.story-add { position: absolute; bottom: -2px; right: -2px; width: 22px; he=
ight: 22px; border-radius: 50%; background: var(--gold); color: rgb(20, 18,=
 14); display: flex; align-items: center; justify-content: center; font-siz=
e: 14px; font-weight: 800; border: 2px solid var(--bg); }

.story-name { font-size: 15px; color: var(--ink-2); text-align: center; whi=
te-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 72p=
x; }

.story-live-badge { position: absolute; top: -4px; left: 50%; transform: tr=
anslateX(-50%); background: rgb(255, 51, 102); color: rgb(255, 255, 255); f=
ont-size: 9px; font-weight: 800; padding: 2px 6px; border-radius: 8px; lett=
er-spacing: 0.04em; text-transform: uppercase; z-index: 2; }

@keyframes pulseLive {=20
  0%, 100% { box-shadow: rgba(255, 51, 102, 0.4) 0px 0px 0px 0px; }
  50% { box-shadow: rgba(255, 51, 102, 0) 0px 0px 0px 6px; }
}

@keyframes pulseLive {=20
  0%, 100% { box-shadow: rgba(255, 51, 102, 0.4) 0px 0px 0px 0px; }
  50% { box-shadow: rgba(255, 51, 102, 0) 0px 0px 0px 6px; }
}

.story-viewer { position: fixed; inset: 0px; z-index: 10000; background: rg=
b(0, 0, 0); display: none; flex-direction: column; }

.story-viewer.on { display: flex; }

.story-v-progress { position: absolute; top: 0px; left: 0px; right: 0px; he=
ight: 3px; background: rgba(255, 255, 255, 0.2); z-index: 10; }

.story-v-progress-bar { height: 100%; background: rgb(255, 255, 255); width=
: 0%; transition: width 0.1s linear; }

.story-v-header { position: absolute; top: 16px; left: 16px; right: 16px; d=
isplay: flex; align-items: center; gap: 12px; z-index: 10; }

.story-v-av { width: 36px; height: 36px; border-radius: 50%; background: li=
near-gradient(145deg,var(--gold-hi),var(--gold-deep)); display: flex; align=
-items: center; justify-content: center; font-weight: 800; font-size: 14px;=
 color: rgb(20, 18, 14); overflow: hidden; }

.story-v-av img { width: 100%; height: 100%; object-fit: cover; }

.story-v-info { flex: 1 1 0%; }

.story-v-name { font-weight: 700; font-size: 14px; color: rgb(255, 255, 255=
); }

.story-v-time { font-size: 15px; color: rgba(255, 255, 255, 0.6); }

.story-v-close { position: absolute; top: 12px; right: 16px; width: 36px; h=
