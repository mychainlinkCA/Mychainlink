@media (max-width: 400px) {
  .auth-container { padding-inline: 16px; }
  .auth-logo img { width: 148px; }
  .auth-banner { padding-inline: 12px; }
  .auth-banner .no-filters { font-size: 15px; letter-spacing: 0.11em; }
  .auth-box { padding: 22px 18px 24px; }
  .auth-form h2 { font-size: 25px; }
  .fg-split { grid-template-columns: 1fr; }
  .pw-reqs { grid-template-columns: 1fr; }
  .phead .av { width: 80px; height: 80px; font-size: 29px; }
  .p-card { flex-direction: column; align-items: flex-start; }
  .p-card .actions { width: 100%; }
  .p-card .actions .btn { flex: 1 1 0%; }
  .pstats { gap: 6px; }
  .pstat .n { font-size: 20px; }
  .mit { padding: 6px; font-size: 10px; }
  .mit svg { width: 18px; height: 18px; }
}

@media (min-width: 768px) {
  .auth-container { padding: 60px 40px 96px; }
  .auth-box { max-width: 440px; }
  .auth-banner { max-width: 440px; }
  .page { padding: 26px 40px; }
  .phead { margin: -26px -40px 24px; padding: 44px 40px 32px; }
  .post, .creator, .p-card { max-width: 680px; margin-left: auto; margin-ri=
ght: auto; }
  #fd, .p-list { max-width: 680px; margin-left: auto; margin-right: auto; }
  .bnav { height: 70px; }
}

@media (prefers-reduced-motion: reduce) {
  *, ::before, ::after { animation-duration: 0.001ms !important; animation-=
iteration-count: 1 !important; transition-duration: 0.001ms !important; }
}

.step-dot { width: 10px; height: 10px; border-radius: 50%; background: var(=
--line); display: inline-block; transition: 0.3s; }

.step-dot.a { background: var(--gold); transform: scale(1.2); }
