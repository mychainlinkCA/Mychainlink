@charset "utf-8";

.bot-config[data-v-76d04e0d] { box-sizing: border-box; width: 100%; height:=
 100%; overflow: hidden; }

.bot-config .bot-config-sheet[data-v-76d04e0d] { box-sizing: border-box; fl=
ex-direction: column; width: 100%; height: 100%; min-height: 0px; display: =
flex; }

.bot-config .bot-config-body[data-v-76d04e0d] { flex: 1 1 0%; min-height: 0=
px; overflow: auto; }

.bot-config-header[data-v-76d04e0d] { flex-shrink: 0; }

.bot-file[data-v-b1cfa614] { flex-direction: column; width: 100%; height: 1=
00%; display: flex; }

.bot-file-header[data-v-b1cfa614] { flex-shrink: 0; }

.bot-panel[data-v-a4fa91cc] { box-sizing: border-box; z-index: 20; border-l=
eft: .5px solid var(--Separators-S1); background: var(--Bg-Primary); width:=
 30%; min-width: 400px; max-width: 576px; overflow: hidden; }

.bot-panel--large[data-v-a4fa91cc] { width: 70%; max-width: 70%; }

.slide-enter-active[data-v-a4fa91cc], .slide-leave-active[data-v-a4fa91cc] =
{ transition: transform 0.3s ease-in-out; }

.slide-enter-from[data-v-a4fa91cc], .slide-leave-to[data-v-a4fa91cc] { tran=
sform: translate(100%); }

@media (max-width: 1000px) {
  .bot-panel[data-v-a4fa91cc] { background: var(--MaskBg-Dark); z-index: 30=
; box-sizing: border-box; border-left-width: medium; border-left-style: non=
e; border-left-color: currentcolor; padding-top: 32px; position: fixed; top=
: 0px; left: 0px; transform: translateY(0px); width: 100vw !important; max-=
width: 100vw !important; height: 100dvh !important; min-width: unset !impor=
tant; }
  .bot-panel[data-v-a4fa91cc] .bot-config-sheet, .bot-panel[data-v-a4fa91cc=
] .bot-file { background: var(--Bg-Primary); border-radius: 20px 20px 0px 0=
px; overflow: hidden; }
  .slide-enter-active[data-v-a4fa91cc], .slide-leave-active[data-v-a4fa91cc=
] { transition: opacity 0.3s ease-in-out; }
  .slide-enter-active[data-v-a4fa91cc] .bot-config-sheet, .slide-enter-acti=
ve[data-v-a4fa91cc] .bot-file, .slide-leave-active[data-v-a4fa91cc] .bot-co=
nfig-sheet, .slide-leave-active[data-v-a4fa91cc] .bot-file { transition: tr=
ansform 0.3s ease-in-out; }
  .slide-enter-from[data-v-a4fa91cc], .slide-leave-to[data-v-a4fa91cc] { op=
acity: 0; transform: none; }
  .slide-enter-from[data-v-a4fa91cc] .bot-config-sheet, .slide-enter-from[d=
ata-v-a4fa91cc] .bot-file, .slide-leave-to[data-v-a4fa91cc] .bot-config-she=
et, .slide-leave-to[data-v-a4fa91cc] .bot-file { transform: translateY(100%=
); }
}

.header-title[data-v-e2b00621] { color: var(--Labels-Primary); text-align: =
center; align-items: center; gap: 4px; max-width: 100%; padding-left: 16px;=
 font-size: 16px; line-height: 24px; display: flex; }

.header-title-content[data-v-e2b00621] { text-overflow: ellipsis; white-spa=
ce: nowrap; flex: 1 1 0%; overflow: hidden; }

.header-action[data-v-e2b00621] { cursor: pointer; justify-content: center;=
 align-items: center; width: 32px; height: 32px; display: flex; }

.chat-loading[data-v-e2b00621] { flex: 1 1 0%; justify-content: center; ali=
gn-items: center; display: flex; }
