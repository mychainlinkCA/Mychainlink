* { box-sizing: border-box; margin: 0px; padding: 0px; }

html, body { width: 100%; background: transparent; }

body { margin: 0px; color: var(--kimi-color-text-primary, var(--seo-chat-La=
bels-Primary)); font-family: var( --kimi-font-sans, var(--font-sans, system=
-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif) ); font-siz=
e: 16px; line-height: 1.5; font-synthesis: none; text-rendering: optimizele=
gibility; -webkit-font-smoothing: antialiased; }

input, select, textarea, button { font: inherit; }

button { cursor: pointer; }

button:disabled { cursor: not-allowed; }

a { color: var(--kimi-color-accent, var(--color-accent, currentColor)); }

html, body { scrollbar-width: none; }

html::-webkit-scrollbar, body::-webkit-scrollbar { width: 0px; height: 0px;=
 }

::-webkit-scrollbar { width: var(--app-scrollbar-size, 8px); height: var(--=
app-scrollbar-size, 8px); }

::-webkit-scrollbar-track { background: transparent; }

::-webkit-scrollbar-thumb { border-radius: 4px; background: var(--app-scrol=
lbar-thumb, var(--seo-chat-Separators-S1)); }

::-webkit-scrollbar-thumb:hover { background: var(--app-scrollbar-thumb-hov=
er, var(--seo-chat-Labels-Tertiary)); }

#widget-root { width: 100%; position: relative; overflow: hidden; }

#widget-root > svg { display: block; margin-inline: auto; max-width: 100%; =
height: auto; overflow: visible; }

#widget-root.streaming :where(svg, circle, rect, path, polygon, polyline, l=
ine, ellipse, g, text):not([transform]):not([opacity]) { transition: fill 0=
.4s ease-out, stroke 0.4s ease-out, opacity 0.4s ease-out; animation: 0.5s =
ease-out 0s 1 normal none running svgFadeInScale; transform-origin: center =
center; }

@media (prefers-reduced-motion: reduce) {
  *, ::before, ::after { animation-duration: 0.01ms !important; animation-i=
teration-count: 1 !important; scroll-behavior: auto !important; transition-=
duration: 0.01ms !important; }
}
